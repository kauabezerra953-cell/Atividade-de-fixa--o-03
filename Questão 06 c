#include <stdio.h>

int main() {
    int opcao;

    printf("=== SISTEMA DE ATENDIMENTO ===\n");
    printf("1 - Suporte Tecnico\n");
    printf("2 - Financeiro\n");
    printf("3 - Recursos Humanos\n");
    printf("4 - Comercial\n");
    printf("5 - Encerrar Atendimento\n");
    printf("Escolha um setor: ");
    scanf("%d", &opcao);

    switch (opcao) {
        case 1:
            printf("Setor: Suporte Tecnico\n");
            printf("Atendimento para problemas com sistemas, computadores, redes e equipamentos.\n");
            break;
        case 2:
            printf("Setor: Financeiro\n");
            printf("Atendimento para pagamentos, cobrancas, contratos e faturamento.\n");
            break;
        case 3:
            printf("Setor: Recursos Humanos\n");
            printf("Atendimento para colaboradores, beneficios e documentos internos.\n");
            break;
        case 4:
            printf("Setor: Comercial\n");
            printf("Atendimento para propostas, vendas, clientes e negociacoes.\n");
            break;
        case 5:
            printf("Atendimento encerrado. Obrigado pelo contato!\n");
            break;
        default:
            printf("Opcao invalida. Escolha um setor disponivel.\n");
    }

    return 0;
}
