#include <stdio.h>

int main() {
    int opcao;

    printf("=== GESTAO DE TRANSPORTE ===\n");
    printf("1 - Carro\n");
    printf("2 - Motocicleta\n");
    printf("3 - Van\n");
    printf("4 - Onibus\n");
    printf("5 - Caminhao\n");
    printf("6 - Encerrar\n");
    printf("Escolha uma opcao: ");
    scanf("%d", &opcao);

    switch (opcao) {
        case 1:
            printf("Carro - Transporte de passageiros em pequena quantidade.\n");
            break;
        case 2:
            printf("Motocicleta - Entregas rapidas e transporte de pequenas cargas.\n");
            break;
        case 3:
            printf("Van - Transporte de passageiros ou pequenas cargas.\n");
            break;
        case 4:
            printf("Onibus - Transporte coletivo de passageiros.\n");
            break;
        case 5:
            printf("Caminhao - Transporte de cargas.\n");
            break;
        case 6:
            printf("Sistema encerrado. Obrigado!\n");
            break;
        default:
            printf("Opcao invalida.\n");
    }

    return 0;
}
